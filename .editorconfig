root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,ts,js,cjs,mjs,md}]
indent_style = space
indent_size = 2

[*.swift]
indent_style = space
indent_size = 4

[Caddyfile]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
