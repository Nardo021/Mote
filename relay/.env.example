MOTE_ENV=development
MOTE_HOST=127.0.0.1
MOTE_PORT=3000
MOTE_PUBLIC_URL=http://127.0.0.1:3000
MOTE_DATABASE_PATH=./data/mote.sqlite
MOTE_LOG_LEVEL=info
MOTE_COMMAND_TTL_MS=10000
MOTE_COMMAND_TIMEOUT_MS=12000
MOTE_HEARTBEAT_STALE_MS=90000
MOTE_AUTH_TIMEOUT_MS=5000
MOTE_MAX_BODY_BYTES=16384
# Optional. Development default is ../dashboard/dist
# MOTE_DASHBOARD_DIST=../dashboard/dist
