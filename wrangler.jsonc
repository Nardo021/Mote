{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mote",
  "main": "relay/src/worker/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "MoteRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MoteRelay"]
    }
  ],
  "vars": {
    "MOTE_ADMIN_USERNAME": "admin"
  }
}
