{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mote-cloud-local-ci",
  "main": "../relay/src/cloud/cloudWorker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "MOTE_CLOUD_STAGING_ENABLED": "true",
    "APPLE_CLIENT_ID": "com.nardo021.mote.localci"
  },
  "d1_databases": [
    {
      "binding": "CLOUD_DB",
      "database_name": "mote-cloud-local-only",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLOUD_TENANTS",
        "class_name": "MoteCloudTenant"
      }
    ]
  },
  "migrations": [
    {
      "tag": "cloud-v1",
      "new_sqlite_classes": [
        "MoteCloudTenant"
      ]
    }
  ]
}
