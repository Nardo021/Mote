MOTE_ENV=production
MOTE_HOST=0.0.0.0
MOTE_PORT=3000
MOTE_PUBLIC_URL=https://relay.yanze.me
MOTE_DATABASE_PATH=/data/mote.sqlite
MOTE_LOG_LEVEL=info
MOTE_COMMAND_TTL_MS=10000
MOTE_COMMAND_TIMEOUT_MS=12000
MOTE_HEARTBEAT_STALE_MS=90000
